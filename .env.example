# Copy to .env and fill in. .env is gitignored — never commit real tokens.
#
# These are the same values already set as Netlify environment variables.
# Netlify reads them at deploy time; the offline scripts in scripts/ run on
# your machine and need a local copy.
#
# Get them from: Netlify → Site configuration → Environment variables
# (or from the Turso dashboard for acra-small).

# libsql://... or https://... — either form works, the client normalises it.
TURSO_URL=

# READ-ONLY token. Used by query.js in production and by scripts/db-status.js.
TURSO_AUTH_TOKEN=

# READ-WRITE token. Used by enrich-save.js in production and by
# scripts/migrate.js. Keep it separate from the read-only token above —
# that separation is deliberate and worth preserving.
TURSO_WRITE_TOKEN=

# Company OpenRouter key. Production reads this from Netlify, not from here —
# the app never needs a local copy. Only scripts/cost-probe.js uses it, to
# measure what an enrichment actually costs. Leave blank unless you are
# running that probe.
OPENROUTER_API_KEY=
